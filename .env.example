JWT_ISSUER=
JWT_SECRET=
JWT_TTL_SECONDS=
POSTGRES_USER=
POSTGRES_PASSWORD=
ELASTICSEARCH_USER=
ELASTICSEARCH_PASSWORD=
SLACK_WEBHOOK_URL=
SLACK_CHANNEL=
SLACK_ALERTS_ENABLED=
GRAFANA_ADMIN_PASSWORD=
ENVIRONMENT=

# 내부 API 공유 시크릿 — /internal/** 과 Alertmanager webhook 이 같은 값을 쓴다.
# 운영에서는 app.security.internal-key-required=true 와 함께 반드시 채운다(fail-closed).
INTERNAL_API_KEY=

# Application Configuration
APP_BASE_URL=

# Mail Configuration (Gmail 예시)
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
SUPPORT_EMAIL=

# 네이버 개발자 센터
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# dummy local value for E2E routing verification (no real Toss calls made)
TOSS_SECRET_KEY=

# 현금영수증 대행 연동 (order-service). 운영(prod) 프로파일에서만 실 연동이 뜬다.
# ENABLED=true 로 켜면 아래 두 값이 필수다 — 비어 있으면 기동이 실패한다(fail-closed).
# 끈 채로 두면 운영에서도 "발급 불가"를 명시적으로 돌려준다(모의 발급으로 위장하지 않는다).
APP_CASH_RECEIPT_ENABLED=false
CASH_RECEIPT_BASE_URL=
CASH_RECEIPT_MERCHANT_ID=
CASH_RECEIPT_SECRET_KEY=
