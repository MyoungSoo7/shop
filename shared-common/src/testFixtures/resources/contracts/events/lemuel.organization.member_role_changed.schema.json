{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "lemuel.organization.member_role_changed",
  "description": "활성 멤버의 역할이 변경된 사실. previousRole/newRole 은 OWNER|MANAGER|STAFF — 이전 값을 함께 싣는 이유는 수신 측이 자기 스냅샷과 비교해 전이를 놓쳤는지 알 수 있어야 하기 때문이다.",
  "type": "object",
  "properties": {
    "organizationId": { "type": "integer" },
    "userId": { "type": "integer" },
    "membershipId": { "type": "integer" },
    "previousRole": { "type": "string", "enum": ["OWNER", "MANAGER", "STAFF"] },
    "newRole": { "type": "string", "enum": ["OWNER", "MANAGER", "STAFF"] }
  },
  "required": [
    "organizationId",
    "userId",
    "membershipId",
    "previousRole",
    "newRole"
  ],
  "additionalProperties": true
}
