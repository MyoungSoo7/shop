{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "lemuel.payment.captured",
  "description": "결제가 승인·매입(capture)된 사실. 금액은 BigDecimal.toPlainString() 문자열(정밀도 보존). sellerId/sellerTier/settlementCycle 은 Event-Carried State Transfer(ADR 0020 Phase 1)로 함께 실어, 수신 측이 원본 서비스를 되묻지 않고 자기 판단을 끝낼 수 있게 한다 — 셀러 미할당 시 생략.",
  "type": "object",
  "properties": {
    "paymentId": { "type": "integer" },
    "orderId": { "type": "integer" },
    "amount": { "type": "string", "pattern": "^-?[0-9]+(\\.[0-9]+)?$" },
    "capturedAt": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}(:[0-9]{2}(\\.[0-9]{1,9})?)?$" },
    "paymentMethod": { "type": "string" },
    "pgTransactionId": { "type": "string" },
    "sellerId": { "type": "integer" },
    "sellerTier": { "type": "string" },
    "settlementCycle": { "type": "string" }
  },
  "required": ["paymentId", "orderId", "amount"],
  "additionalProperties": true
}
